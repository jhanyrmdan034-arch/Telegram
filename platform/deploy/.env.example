# ===========================================================================
# Deployment environment for docker compose. Copy to .env and replace every
# CHANGE_ME value. .env must never be committed.
# ===========================================================================

# --- PostgreSQL
POSTGRES_DB=messenger
POSTGRES_USER=messenger
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- Application
ENVIRONMENT=production
DEBUG=false
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PUBLIC_BASE_URL=https://api.example.com
MAX_FILE_SIZE_BYTES=209715200
STORAGE_BACKEND=local
API_WORKERS=2

# --- Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- TURN (voice/video relay)
TURN_REALM=messenger.local
TURN_EXTERNAL_IP=CHANGE_ME_public_ip
TURN_USERNAME=messenger
TURN_PASSWORD=CHANGE_ME_turn_password
TURN_URL=turn:turn.example.com:3478?transport=udp

# --- Backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
BACKUP_ENCRYPTION_KEY=CHANGE_ME_backup_encryption_key
