# ---------------------------------------------------------------------------
# All sensitive configuration is supplied through environment variables.
# Copy to .env and fill in real values. Never commit a filled .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=production
DEBUG=false

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://messenger:CHANGE_ME@postgres:5432/messenger
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Redis (cache, sessions bookkeeping, rate limiting, realtime fan-out)
REDIS_URL=redis://redis:6379/0

# Secrets: generate with `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# File storage
STORAGE_BACKEND=local
STORAGE_DIR=/var/lib/messenger/files
MAX_FILE_SIZE_BYTES=209715200
PUBLIC_BASE_URL=https://api.example.com

# Rate limiting (requests per window, per IP and per user)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Bootstrap: first super admin is created by `python -m app.cli create-superuser`
BOOTSTRAP_ADMIN_USERNAME=

# TURN server for call media relay (see deploy/coturn/turnserver.conf)
TURN_URL=turn:turn.example.com:3478?transport=udp
TURN_USERNAME=messenger
TURN_PASSWORD=CHANGE_ME
